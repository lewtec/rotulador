package layout

import "github.com/lewtec/rotulador/internal/i18n"

templ Shell(p ShellProps) {
	@Document(p.Title) {
		<body class="bg-base-100">
			<header>
				<nav class="bg-base-200 shadow-lg">
					<div class="container mx-auto flex items-center justify-between px-4 py-2">
						<div class="flex-1">
							<a href="/" class="btn btn-ghost text-xl">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
								</svg>
								Rotulador
							</a>
						</div>
						<div class="flex-none">
							<ul class="menu menu-horizontal px-1">
								<li><a href="/">{ i18n.T(ctx, "Home") }</a></li>
								<li><a href="/help">{ i18n.T(ctx, "Help") }</a></li>
								<li><a href="/annotate">{ i18n.T(ctx, "Annotate") }</a></li>
								<li>
									<a onclick="toggleTheme(); return false;" href="#" aria-label={ i18n.T(ctx, "Toggle theme") }>
										<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
										</svg>
									</a>
								</li>
							</ul>
						</div>
					</div>
				</nav>
			</header>
			<main class="container mx-auto px-4 py-8">
				{ children... }
			</main>
			<footer class="footer footer-center p-4 bg-base-200 text-base-content mt-8">
				<aside>
					<p>Rotulador - { i18n.T(ctx, "Image Annotation Tool") }</p>
				</aside>
			</footer>
		</body>
	}
}
