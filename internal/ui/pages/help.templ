package pages

import (
	"fmt"

	"github.com/lewtec/rotulador/internal/i18n"
	"github.com/lewtec/rotulador/internal/ui/components"
	"github.com/lewtec/rotulador/internal/ui/layout"
)

templ Help(shell layout.ShellProps, d HelpData) {
	@layout.Shell(shell) {
		<div class="breadcrumbs text-sm mb-4">
			<ul>
				<li><a href="/">{ i18n.T(ctx, "Home") }</a></li>
				<li>{ i18n.T(ctx, "Help") }</li>
			</ul>
		</div>
		<div class="prose max-w-none">
			<h1>{ i18n.T(ctx, "Project help") }</h1>
			if len(d.Tasks) == 1 {
				@helpProgressCard(d.Tasks[0], true)
			}
			<h2>{ i18n.T(ctx, "ProjectDescription") }</h2>
			if d.Description != "" {
				<div>@components.Markdown(d.Description)</div>
			} else {
				<p class="text-base-content/70">{ i18n.T(ctx, "(No description provided)") }</p>
			}
			if d.Detail != nil {
				@helpTaskDetail(d.Detail)
			}
		</div>
		if len(d.Tasks) > 1 {
			<div class="mt-8">
				<h2 class="text-2xl font-bold mb-6">{ i18n.T(ctx, "Annotation Phases") }</h2>
				for index, task := range d.Tasks {
					<div class="mb-6">
						<div class="card bg-base-200 shadow-xl">
							<div class="card-body">
								<h2 class="card-title">{ task.ShortName }</h2>
								<p class="text-sm">{ task.Name }</p>
								<div class="mt-3">
									<div class="flex justify-between text-xs mb-1">
										<span class="font-semibold">{ i18n.T(ctx, "Progress") }</span>
										<span>
											{ fmt.Sprintf("%d/%d", task.CompletedCount, task.TotalCount) }
											{ i18n.T(ctx, "eligible") }
											if task.PhaseProgress != nil {
												{ fmt.Sprintf(" (%d %s)", task.PhaseProgress.Total, i18n.T(ctx, "total")) }
											}
										</span>
									</div>
									@components.ProgressBar(task.PhaseProgress)
								</div>
								if len(task.If) > 0 {
									<div class="mt-2">
										<span class="text-xs font-semibold opacity-70">{ i18n.T(ctx, "Dependencies:") }</span>
										<div class="flex flex-wrap gap-1 mt-1">
											for depTask, depValue := range task.If {
												<div class="badge badge-outline badge-sm">{ depTask }: { depValue }</div>
											}
										</div>
									</div>
								}
								<div class="card-actions justify-end mt-2">
									<a href={ fmt.Sprintf("/help/%s", task.ID) } class="btn btn-sm btn-primary">{ i18n.T(ctx, "View Details") }</a>
									if task.AvailableCount > 0 {
										<a href={ fmt.Sprintf("/annotate?task=%s", task.ID) } class="btn btn-sm btn-accent">{ i18n.T(ctx, "Annotate") }</a>
									}
								</div>
							</div>
						</div>
						if index != len(d.Tasks)-1 {
							<div class="flex justify-center my-4">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
								</svg>
							</div>
						}
					</div>
				}
			</div>
		}
	}
}

templ helpProgressCard(task HelpTask, showBack bool) {
	<div class="card bg-base-200 shadow-xl my-6 not-prose">
		<div class="card-body">
			<h3 class="card-title text-base">{ i18n.T(ctx, "Progress") }</h3>
			<div class="text-xs mb-2">
				{ fmt.Sprintf("%d/%d", task.CompletedCount, task.TotalCount) }
				{ i18n.T(ctx, "eligible") }
				if task.PhaseProgress != nil {
					{ fmt.Sprintf(" (%d %s)", task.PhaseProgress.Total, i18n.T(ctx, "total")) }
				}
			</div>
			@components.ProgressBar(task.PhaseProgress)
			if len(task.If) > 0 {
				<div class="mt-2">
					<span class="text-xs font-semibold opacity-70">{ i18n.T(ctx, "Dependencies:") }</span>
					<div class="flex flex-wrap gap-1 mt-1">
						for depTask, depValue := range task.If {
							<div class="badge badge-outline badge-sm">{ depTask }: { depValue }</div>
						}
					</div>
				</div>
			}
			<div class="card-actions justify-end mt-2">
				if showBack {
					<a href="/help" class="btn btn-sm btn-ghost">{ i18n.T(ctx, "Back to Overview") }</a>
				}
				if task.AvailableCount > 0 {
					<a href={ fmt.Sprintf("/annotate?task=%s", task.ID) } class="btn btn-sm btn-accent">{ i18n.T(ctx, "Start Annotation") }</a>
				} else {
					<span class="text-xs opacity-70">{ i18n.T(ctx, "All images annotated") }</span>
				}
			</div>
		</div>
	</div>
}

templ helpTaskDetail(task *HelpTask) {
	<h2>{ i18n.T(ctx, "Phase") }: { task.ShortName }</h2>
	<div>@components.Markdown(task.Name)</div>
	<h3>{ i18n.T(ctx, "Possible choices") }</h3>
	for _, class := range task.Classes {
		<h4 class="flex items-center gap-2">
			<span>
				if class.Name != "" {
					{ i18n.T(ctx, class.Name) }
				} else {
					{ i18n.T(ctx, "(No name)") }
				}
			</span>
			<span class="badge badge-outline badge-sm not-prose">{ class.ID }</span>
		</h4>
		if class.Description != "" {
			<div>@components.Markdown(class.Description)</div>
		} else {
			<p class="text-base-content/70">{ i18n.T(ctx, "(No description provided)") }</p>
		}
		if len(class.Examples) > 0 {
			<h5>{ i18n.T(ctx, "Examples") }</h5>
			for _, ex := range class.Examples {
				<img src={ fmt.Sprintf("/asset/%s", ex) } alt="Example"/>
			}
		}
	}
}
