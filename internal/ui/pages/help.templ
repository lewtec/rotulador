package pages

import (
	"fmt"

	"github.com/lewtec/rotulador/internal/i18n"
	"github.com/lewtec/rotulador/internal/ui/components"
	"github.com/lewtec/rotulador/internal/ui/layout"
)

templ Help(shell layout.ShellProps, d HelpData) {
	@layout.Shell(shell) {
		@layout.PageHeader(layout.PageHeaderProps{
			Title: i18n.T(ctx, "Project help"),
			Crumbs: []layout.Crumb{
				{Label: i18n.T(ctx, "Home"), Href: "/"},
				{Label: i18n.T(ctx, "Help")},
			},
		})
		@layout.PageBody() {
			if len(d.Tasks) == 1 {
				@helpProgressCard(d.Tasks[0], true)
			}
			<section class="prose max-w-none">
				<h2>{ i18n.T(ctx, "ProjectDescription") }</h2>
				if d.Description != "" {
					<div>@components.Markdown(d.Description)</div>
				} else {
					<p class="text-base-content/70">{ i18n.T(ctx, "(No description provided)") }</p>
				}
				if d.Detail != nil {
					@helpTaskDetail(d.Detail)
				}
			</section>
			if len(d.Tasks) > 1 {
				<section class="not-prose">
					<h2 class="mb-4 text-xl font-semibold tracking-tight">{ i18n.T(ctx, "Annotation Phases") }</h2>
					for index, task := range d.Tasks {
						<div class="mb-4">
							<div class="card border border-base-300 bg-base-100 shadow-sm">
								<div class="card-body gap-3">
									<h3 class="card-title text-lg">{ task.ShortName }</h3>
									<p class="text-sm text-base-content/70">{ task.Name }</p>
									<div>
										<div class="mb-1 flex justify-between text-xs">
											<span class="font-medium">{ i18n.T(ctx, "Progress") }</span>
											<span class="tabular-nums text-base-content/70">
												{ fmt.Sprintf("%d/%d", task.CompletedCount, task.TotalCount) }
												{ i18n.T(ctx, "eligible") }
												if task.PhaseProgress != nil {
													{ fmt.Sprintf(" (%d %s)", task.PhaseProgress.Total, i18n.T(ctx, "total")) }
												}
											</span>
										</div>
										@components.ProgressBar(task.PhaseProgress)
									</div>
									if len(task.If) > 0 {
										<div>
											<span class="text-xs font-medium text-base-content/60">{ i18n.T(ctx, "Dependencies:") }</span>
											<div class="mt-1 flex flex-wrap gap-1">
												for depTask, depValue := range task.If {
													<div class="badge badge-outline badge-sm">{ depTask }: { depValue }</div>
												}
											</div>
										</div>
									}
									<div class="card-actions justify-end">
										<a href={ fmt.Sprintf("/help/%s", task.ID) } class={ layout.HeaderBtnPrimary }>{ i18n.T(ctx, "View Details") }</a>
										if task.AvailableCount > 0 {
											<a href={ fmt.Sprintf("/annotate?task=%s", task.ID) } class="btn btn-sm btn-accent">{ i18n.T(ctx, "Annotate") }</a>
										}
									</div>
								</div>
							</div>
							if index != len(d.Tasks)-1 {
								<div class="flex justify-center py-2 text-base-content/40" aria-hidden="true">↓</div>
							}
						</div>
					}
				</section>
			}
		}
	}
}

templ helpProgressCard(task HelpTask, showBack bool) {
	<div class="card mb-6 border border-base-300 bg-base-100 shadow-sm not-prose">
		<div class="card-body gap-3">
			<h3 class="card-title text-base">{ i18n.T(ctx, "Progress") }</h3>
			<div class="text-xs text-base-content/70 tabular-nums">
				{ fmt.Sprintf("%d/%d", task.CompletedCount, task.TotalCount) }
				{ i18n.T(ctx, "eligible") }
				if task.PhaseProgress != nil {
					{ fmt.Sprintf(" (%d %s)", task.PhaseProgress.Total, i18n.T(ctx, "total")) }
				}
			</div>
			@components.ProgressBar(task.PhaseProgress)
			if len(task.If) > 0 {
				<div>
					<span class="text-xs font-medium text-base-content/60">{ i18n.T(ctx, "Dependencies:") }</span>
					<div class="mt-1 flex flex-wrap gap-1">
						for depTask, depValue := range task.If {
							<div class="badge badge-outline badge-sm">{ depTask }: { depValue }</div>
						}
					</div>
				</div>
			}
			<div class="card-actions justify-end">
				if showBack {
					<a href="/help" class={ layout.HeaderBtn }>{ i18n.T(ctx, "Back to Overview") }</a>
				}
				if task.AvailableCount > 0 {
					<a href={ fmt.Sprintf("/annotate?task=%s", task.ID) } class="btn btn-sm btn-accent">{ i18n.T(ctx, "Start Annotation") }</a>
				} else {
					<span class="text-xs text-base-content/60">{ i18n.T(ctx, "All images annotated") }</span>
				}
			</div>
		</div>
	</div>
}

templ helpTaskDetail(task *HelpTask) {
	<h2>{ i18n.T(ctx, "Phase") }: { task.ShortName }</h2>
	<div>@components.Markdown(task.Name)</div>
	<h3>{ i18n.T(ctx, "Possible choices") }</h3>
	for _, class := range task.Classes {
		<h4 class="flex items-center gap-2">
			<span>
				if class.Name != "" {
					{ i18n.T(ctx, class.Name) }
				} else {
					{ i18n.T(ctx, "(No name)") }
				}
			</span>
			<span class="badge badge-outline badge-sm not-prose">{ class.ID }</span>
		</h4>
		if class.Description != "" {
			<div>@components.Markdown(class.Description)</div>
		} else {
			<p class="text-base-content/70">{ i18n.T(ctx, "(No description provided)") }</p>
		}
		if len(class.Examples) > 0 {
			<h5>{ i18n.T(ctx, "Examples") }</h5>
			for _, ex := range class.Examples {
				<img src={ fmt.Sprintf("/asset/%s", ex) } alt="Example"/>
			}
		}
	}
}
