package pages

import (
	"encoding/json"
	"fmt"

	"github.com/lewtec/rotulador/internal/i18n"
	"github.com/lewtec/rotulador/internal/ui/components"
	"github.com/lewtec/rotulador/internal/ui/layout"
)

templ Annotate(shell layout.ShellProps, d AnnotateData) {
	@layout.ShellColumn(shell) {
		<main id="app-main" class="relative flex min-h-0 flex-1 flex-col overflow-hidden">
			// Compact meta stays shrink-0; image pane takes every leftover pixel.
			<div class="shrink-0 space-y-1 px-3 pt-2 sm:px-4">
				<div class="flex min-w-0 items-center gap-2 text-xs text-base-content/50">
					<nav class="min-w-0 flex-1 truncate" aria-label="Breadcrumb">
						<a class="link link-hover" href="/">{ i18n.T(ctx, "Home") }</a>
						<span class="text-base-content/40"> / </span>
						<a class="link link-hover" href={ fmt.Sprintf("/help/%s", d.TaskID) }>{ d.TaskName }</a>
						<span class="text-base-content/40"> / </span>
						<span class="text-base-content/70">{ i18n.T(ctx, "Annotate") }</span>
						<span class="text-base-content/40"> / </span>
						// Filename stays out of JS string literals: data attributes only.
						<button
							type="button"
							class="font-mono max-w-[40%] truncate align-baseline text-left text-base-content/60 hover:text-base-content"
							data-filename={ d.ImageFilename }
							data-copied={ i18n.T(ctx, "Copied to clipboard!") }
							onclick="navigator.clipboard.writeText(this.dataset.filename); showToast(this.dataset.copied)"
							title={ d.ImageFilename }
						>
							{ d.ImageFilename }
						</button>
					</nav>
					if d.Progress != nil {
						<span class="shrink-0 tabular-nums text-base-content/60">
							{ fmt.Sprintf("%d/%d", d.Progress.CompletedCount, d.Progress.TotalCount) }
						</span>
					}
				</div>
				@layout.PageHeader(layout.PageHeaderProps{
					Title:      d.TaskName,
					Compact:    true,
					HasActions: true,
				}) {
					<a href={ fmt.Sprintf("/help/%s", d.TaskID) } class={ layout.HeaderBtn }>
						{ i18n.T(ctx, "Help") }
					</a>
				}
			</div>
			// Absolute fill + object-contain: max-* alone does not grow into flex free space.
			<div class="relative min-h-0 w-full flex-1 overflow-hidden bg-base-100">
				<img
					src={ fmt.Sprintf("/asset/%s", d.ImageID) }
					alt="Image to annotate"
					class="absolute inset-0 h-full w-full object-contain"
				/>
				<div id="copy-toast" class="toast toast-center toast-bottom pointer-events-none absolute inset-x-0 bottom-2 z-10 hidden">
					<div class="alert alert-success py-2 text-sm shadow">
						<span id="copy-toast-message">{ i18n.T(ctx, "Copied to clipboard!") }</span>
					</div>
				</div>
			</div>
		</main>
		<div id="app-dock" class="shrink-0 border-t border-base-300 bg-base-100">
			@annotateDock(d)
		</div>
		<script>
			document.addEventListener('keydown', function (e) {
				const buttons = document.querySelectorAll('#annotation-controls button[data-key]');
				buttons.forEach(button => {
					const key = button.getAttribute('data-key');
					if (key && e.key.toLowerCase() === key.toLowerCase()) {
						e.preventDefault();
						button.click();
					}
				});
			});
			function showToast(message) {
				const toast = document.getElementById('copy-toast');
				const toastMessage = document.getElementById('copy-toast-message');
				if (!toast || !toastMessage) return;
				toastMessage.innerText = message;
				toast.classList.remove('hidden');
				setTimeout(() => {
					toast.classList.add('hidden');
				}, 2000);
			}
		</script>
	}
}

templ annotateDock(d AnnotateData) {
	<div class="px-3 pt-2 pb-3 sm:px-4">
		@components.ProgressBar(d.PhaseProgress)
		<div class="annotation-buttons mt-2 flex flex-wrap gap-2" id="annotation-controls">
			for _, class := range d.Classes {
				<button
					class="btn btn-primary btn-md min-h-12 min-w-[8rem] flex-1"
					hx-post={ fmt.Sprintf("/annotate/%s/%s", d.TaskID, d.ImageID) }
					hx-vals={ hxVals(class.ID, "on") }
					data-key={ class.Key }
				>
					{ i18n.T(ctx, class.Name) }
					if class.Key != "" {
						<kbd class="kbd kbd-sm ml-2">{ class.Key }</kbd>
					}
				</button>
			}
			<button
				class="btn btn-warning btn-md min-h-12 min-w-[8rem] flex-1"
				hx-post={ fmt.Sprintf("/annotate/%s/%s", d.TaskID, d.ImageID) }
				hx-vals={ hxVals("", "off") }
				data-key="?"
			>
				{ i18n.T(ctx, "Not Sure") } <kbd class="kbd kbd-sm ml-2">?</kbd>
			</button>
		</div>
	</div>
}

func hxVals(selectedClass, sure string) string {
	b, err := json.Marshal(map[string]string{
		"selectedClass": selectedClass,
		"sure":          sure,
	})
	if err != nil {
		return `{"selectedClass":"","sure":"off"}`
	}
	return string(b)
}
