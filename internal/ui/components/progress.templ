package components

import (
	"fmt"

	"github.com/lewtec/rotulador/internal/i18n"
)

templ ProgressBar(p *Progress) {
	if p != nil && p.Total > 0 {
		<div class="flex h-7 w-full overflow-hidden rounded-md">
			for _, seg := range p.Segments {
				if seg.Count > 0 {
					<div
						class={ "flex items-center justify-center text-xs transition-all hover:opacity-90 " + seg.Class }
						style={ fmt.Sprintf("width: %g%%", seg.Percent) }
						title={ fmt.Sprintf("%d %s (%.1f%%)", seg.Count, i18n.T(ctx, seg.Label), seg.Percent) }
					>
						if seg.Percent > 5.0 {
							{ fmt.Sprintf("%d", seg.Count) }
						}
					</div>
				}
			}
		</div>
	} else {
		<progress class="progress progress-primary w-full mb-4" value="0" max="100"></progress>
	}
}
